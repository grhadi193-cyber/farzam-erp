# --- Farzam ERP server configuration (copy to .env and fill in) ---

# Port the app listens on
PORT=3000

# First admin account, created automatically on first run if it does not exist.
# Log in with exactly this email/password, then change the password policy
# by managing users from the database/admin tooling.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=مدیر سیستم

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=change-me-long-random-string

# API key for the Pip agent (header: Authorization: Bearer <key>).
# Generate a long random value. Never commit the real key.
PIP_AGENT_API_KEY=change-me-agent-api-key

# Optional: seed clearly-labeled fake demo rows («نمونه») on first run.
# Leave false for production.
SEED_DEMO=false
